[Unit]
Description=LINE Message Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=line-forwarder
Group=line-forwarder
WorkingDirectory=/opt/line-message-forwarder
EnvironmentFile=/opt/line-message-forwarder/.env
ExecStart=/usr/bin/python3 /opt/line-message-forwarder/forwarder_enhanced.py
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
Nice=0
StandardOutput=append:/opt/line-message-forwarder/data/forwarder.log
StandardError=append:/opt/line-message-forwarder/data/forwarder.err.log

[Install]
WantedBy=multi-user.target
